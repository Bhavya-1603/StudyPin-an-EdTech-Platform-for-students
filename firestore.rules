rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120;
      allow update: if isOwner(userId) && isValidId(userId)
        && request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId);
    }

    // 2. Notes Collection (Public Discovery Pins)
    match /notes/{noteId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidId(noteId)
        && request.resource.data.uploaderId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 150
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.category is string
        && request.resource.data.subject is string;
      allow update: if isSignedIn() && isValidId(noteId)
        && resource.data.uploaderId == request.auth.uid
        && request.resource.data.uploaderId == resource.data.uploaderId;
      allow delete: if isSignedIn() && isValidId(noteId)
        && resource.data.uploaderId == request.auth.uid;
    }

    // 3. Boards Collection
    match /boards/{boardId} {
      allow get: if true;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(boardId)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 100;
      allow update: if isSignedIn() && isValidId(boardId)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && isValidId(boardId)
        && resource.data.ownerId == request.auth.uid;
    }
  }
}
